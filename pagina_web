    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 20px;
}

.fotos-inicio img {
    width: 100%;
    height: 250px;

    object-fit: cover;

    border-radius: 10px;

    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);

    transition: transform 0.3s;
}

.fotos-inicio img:hover {
    transform: scale(1.03);
}



.texto-galeria {
    text-align: center;
    font-size: 18px;
    margin: 20px;
}




.galeria {
    width: 90%;
    max-width: 1100px;

    margin: 40px auto;

    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 25px;
}



.pelicula {
    background-color: white;

    border-radius: 10px;

    padding-bottom: 15px;

    text-align: center;

    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);

    cursor: pointer;
}



.pelicula summary {
    list-style: none;
}

.pelicula summary::-webkit-details-marker {
    display: none;
}




.pelicula summary img {
    width: 100%;

    height: 500px;

    object-fit: contain;

    background-color: #e8e1d2;

    cursor: pointer;

    transition: transform 0.3s;
}

.pelicula summary img:hover {
    transform: scale(1.02);
}




.pelicula summary h2 {
    font-size: 22px;
    margin: 15px 5px;
}




.pelicula summary h2::after {
    content: " ▼";

    font-size: 14px;
}

.pelicula[open] summary h2::after {
    content: " ▲";
}




.informacion {
    padding: 10px 20px 20px 20px;

    text-align: left;

    background-color: #eee8dc;

    border-top: 3px solid #b85c5c;
}

.informacion p {
    line-height: 1.5;
}




.informacion h3 {
    text-align: center;

    color: #536b7a;

    margin-top: 25px;
}






.fotos-pelicula img {
    width: 100%;
    height: 200px;

    object-fit: cover;

    border-radius: 8px;

    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);

    cursor: pointer;

    transition: transform 0.3s;
}



.fotos-pelicula img:hover {
    object-fit: contain;

    background-color: #e8e1d2;

    transform: scale(2.5);

    position: relative;

    z-index: 10;
}


.formulario {
    width: 80%;
    max-width: 600px;

    margin: 40px auto;

    background-color: white;

    padding: 30px;

    border-radius: 10px;

    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
}


.imagen-formulario {
    display: block;
    width: 300px;
    margin: 30px auto;
    border-radius: 10px;
}



label {
    display: block;

    margin-top: 15px;

    margin-bottom: 5px;

    font-weight: bold;
}




input,
select,
textarea {
    width: 100%;

    padding: 10px;

    box-sizing: border-box;

    border: 1px solid #aaa;

    border-radius: 5px;

    font-family: Arial, sans-serif;
}




textarea {
    height: 120px;

    resize: vertical;
}




button {
    margin-top: 20px;

    padding: 12px 30px;

    background-color: #536b7a;

    color: white;

    border: none;

    border-radius: 5px;

    cursor: pointer;

    font-size: 16px;
}

button:hover {
    background-color: #354957;
}



@media screen and (max-width: 800px) {

    /* Galería principal */

    .galeria {
        grid-template-columns: 1fr;
    }


    

    .fotos-pelicula {
        grid-template-columns: repeat(2, 1fr);
    }



    .fotos-inicio {
        grid-template-columns: 1fr;
    }


    

    .imagen-inicio {
        width: 90%;
    }


    .pelicula summary img {
        height: 450px;
    }

}
