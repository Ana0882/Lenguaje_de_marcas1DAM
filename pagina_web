    <h1> Formulario de Studio Ghibli</h1>


   

    <div class="formulario">

        <form>

            <label for="nombre">Nombre:</label>

            <input type="text"
                   id="nombre"
                   name="nombre"
                   placeholder="Escribe tu nombre">


            <label for="email">Correo electrónico:</label>

            <input type="email"
                   id="email"
                   name="email"
                   placeholder="ejemplo@correo.com">


            <label for="pelicula">
                ¿Cuál es tu película favorita?
            </label>

            <select id="pelicula" name="pelicula">

                <option value="totoro">
                    Mi vecino Totoro
                </option>

                <option value="chihiro">
                    El viaje de Chihiro
                </option>

                <option value="mononoke">
                    La princesa Mononoke
                </option>

                <option value="castillo">
                    El castillo ambulante
                </option>

                <option value="ponyo">
                    Ponyo
                </option>

                <option value="viento">
                    El viento se levanta
                </option>

            </select>


            <label for="valoracion">
                ¿Qué opinas de las películas de Studio Ghibli?
            </label>

            <textarea id="valoracion"
                      name="valoracion"
                      placeholder="Escribe aquí tu opinión...">
            </textarea>


            <label for="recomendar">
                ¿Recomendarías Studio Ghibli a otras personas?
            </label>

            <select id="recomendar" name="recomendar">

                <option value="si">
                    Sí
                </option>

                <option value="no">
                    No
                </option>

                <option value="talvez">
                    Tal vez
                </option>

            </select>


            <button type="submit">
                Enviar
            </button>

        </form>

    </div>
    
